#######################################
# Service configuration               #
#######################################
#
# Ports and logging for the tile service.
# Adjust HTTP_PORT if running multiple
# services on your dev machine.
#

HTTP_PORT=8080

LOG_LEVEL=info

#######################################
# Tile storage paths                   #
#######################################
#
# TILES_PATH (required): Directory containing
# .mbtiles files to serve. Supports ~ expansion.
# (Legacy: replaced by TILES_ROOT, a release root with
# a `current` symlink, once the PMTiles migration lands.
# See Docs/MIGRATION-DATA-MANAGER.md.)
#
# STYLES_PATH (optional): Directory containing
# map style JSON files. If not set, only
# default style names are advertised.
#

TILES_PATH=~/dev/swayrider/localdata/tiles

#######################################
# Planet tileset (PMTiles)             #
#######################################
#
# PMTILES_URL (optional): the planet PMTiles archive, served as
# tileset "planet" (GET /v1/tiles/planet/{z}/{x}/{y}). Either a
# local file (file:///abs/path/tiles.pmtiles or a plain path) or an
# object in an S3-compatible store (s3://bucket/key, e.g. Garage).
# Empty = tileset "planet" disabled. Every other tileset name keeps
# using the legacy MBTiles index (TILES_PATH). With only PMTILES_URL
# set, legacy tilesets answer 503.
#
# S3_* are used for s3:// locations. Use the READ-ONLY key and set the
# secret through the environment, not a flag.
#

PMTILES_URL=

# S3_ENDPOINT=http://garage:3900
# S3_REGION=garage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

STYLES_PATH=~/dev/swayrider/swayrider/assets/map/styles

#######################################
# Compression settings                 #
#######################################
#
# COMPRESSION_ENABLED: Enable HTTP gzip
# compression for tile responses.
#
# COMPRESSION_CACHE_SIZE: Maximum number
# of compressed tiles to hold in memory.
#

COMPRESSION_ENABLED=true

COMPRESSION_CACHE_SIZE=1000

#######################################
# Disk cache settings                 #
#######################################
#
# DISK_CACHE_ENABLED: Enable persistent
# disk cache for tiles (two-tier caching).
#
# DISK_CACHE_PATH: Directory for disk cache.
# Supports ~ expansion.
# The cache claims this directory with a hidden ownership marker
# (.tilesservice_cache_owner) and only ever deletes its own artifacts inside
# it. Point this at a dedicated cache directory — startup will refuse to clear
# a directory that does not look like a tile cache.
#
# DISK_CACHE_MAX_FILES: Maximum number of
# cached tile files.
#

DISK_CACHE_ENABLED=false

DISK_CACHE_PATH=~/dev/swayrider/localdata/cache

DISK_CACHE_MAX_FILES=100000

#######################################
# Public service URL                 #
#######################################
#
# SERVICE_HOST: Public hostname for the
# service (used in style tile URLs).
#
# SERVICE_PORT: Public port (optional;
# omit for standard ports 80/443).
#
# SERVICE_PREFIX: URL prefix for tile
# endpoints (e.g. /v1/tiles).
#

SERVICE_HOST=https://tiles.example.com

SERVICE_PORT=

SERVICE_PREFIX=/v1/tiles

#######################################
# JWT key refresh                     #
#######################################
#
# AUTHSERVICE_HOST / AUTHSERVICE_PORT:
# Auth service address used to fetch JWT
# public keys for token validation.
#
# JWT_KEYS_REFRESH_INTERVAL_SECS: How often
# (seconds) to refresh JWT public keys from
# authservice (default 300).
#
# JWT_KEYS_FETCH_TIMEOUT_SECS: Upper bound
# (seconds) on a single public-key fetch
# (default 15).
#

AUTHSERVICE_HOST=localhost

AUTHSERVICE_PORT=8081

JWT_KEYS_REFRESH_INTERVAL_SECS=300

JWT_KEYS_FETCH_TIMEOUT_SECS=15